# Solar Irradiance Agent Configuration
# Copy this file to .env and fill in your values

# REQUIRED: Home latitude and longitude
SOLAR_AGENT_LATITUDE=37.7749
SOLAR_AGENT_LONGITUDE=-122.4194

# OPTIONAL: Timezone for forecast (default: auto = infer from lat/long)
SOLAR_AGENT_TIMEZONE=auto

# OPTIONAL: Forecast horizon in days (0-16, default: 2 = tonight + tomorrow)
SOLAR_AGENT_FORECAST_DAYS=2

# OPTIONAL: Weather model for primary GHI/DNI/DHI forecast
# (default: best_match = Open-Meteo's automatic best model)
SOLAR_AGENT_WEATHER_MODEL=best_match

# OPTIONAL: Run mode - cli (run once, print report) or serve (HTTP server)
# (default: cli)
SOLAR_AGENT_MODE=cli

# OPTIONAL: HTTP server host and port (only used in serve mode)
# (defaults: 0.0.0.0 and 8000)
SOLAR_AGENT_HTTP_HOST=0.0.0.0
SOLAR_AGENT_HTTP_PORT=8000

# OPTIONAL: API key for /forecast endpoint (X-API-Key header)
# Leave unset for open access (appropriate for home-network behind firewall)
# SOLAR_AGENT_API_KEY=your-secret-key

# OPTIONAL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# (default: INFO)
SOLAR_AGENT_LOG_LEVEL=INFO

# OPTIONAL: HTTP request timeout in seconds
# (default: 10.0)
SOLAR_AGENT_HTTP_TIMEOUT_SECONDS=10.0

# OPTIONAL: Max retry attempts for transient failures
# (default: 3)
SOLAR_AGENT_RETRY_ATTEMPTS=3

# OPTIONAL: Base backoff for exponential retry (in seconds)
# (default: 1.0)
SOLAR_AGENT_RETRY_BACKOFF_SECONDS=1.0

# OPTIONAL: Open-Meteo API base URL (for commercial tier or self-hosted mirror)
# (default: https://api.open-meteo.com/v1/forecast)
SOLAR_AGENT_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
